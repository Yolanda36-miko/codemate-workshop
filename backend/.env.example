# =============================================================================
# CodeMate 智学工坊 — 环境变量配置
# 复制此文件为 .env 并填入实际值
# =============================================================================

# ---- LLM Provider ----
# 可选值: mock | openai | anthropic
# mock 模式不需要 API key，系统可直接启动和开发
LLM_PROVIDER=mock

# ---- OpenAI ----
# 仅 LLM_PROVIDER=openai 时需要
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# 可选：自定义 base URL（用于代理或兼容 API）
# OPENAI_BASE_URL=

# ---- Anthropic ----
# 仅 LLM_PROVIDER=anthropic 时需要
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Common ----
LLM_MAX_RETRIES=2
LLM_REQUEST_TIMEOUT=60

# ---- Database ----
DATABASE_URL=sqlite:///./codemate.db

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
