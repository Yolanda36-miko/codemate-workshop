# =============================================================================
# CodeMate 智学工坊 — 前端环境变量示例
# 复制此文件为 frontend/.env 并填入实际值
# =============================================================================

# ---- Mock 模式 ----
# true（默认）: 前端使用本地 Mock 数据，不发起网络请求，无需后端
# false: 调用后端 API，需先启动 FastAPI 服务
VITE_USE_MOCK=true

# ---- Demo 模式 ----
# true: 启用示例数据快速填充入口（画像页"使用示例数据快速填充"按钮）
# false（默认）: 不显示快捷填充入口，用户从零开始
VITE_DEMO_MODE=false

# ---- 后端 API 地址 ----
# 仅 VITE_USE_MOCK=false 时生效
# 留空：使用 Vite 开发服务器代理（vite.config.ts 中将 /api 转发到 localhost:8000）
# 填写完整地址：直连后端（如 http://127.0.0.1:8000/api）
VITE_API_BASE_URL=
